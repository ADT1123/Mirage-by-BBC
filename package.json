{
  "name": "mirage",
  "version": "1.0.0",
  "description": "A live, widget-powered desktop wallpaper with 11 theme packs, a visual editor and a Claude-style CLI.",
  "main": "src/main/main.cjs",
  "bin": {
    "brow": "cli/main.mjs"
  },
  "scripts": {
    "start": "node cli/main.mjs start",
    "stop": "node cli/main.mjs stop",
    "dev": "electron .",
    "cli": "node cli/main.mjs",
    "snapshot": "electron scripts/snapshot.cjs",
    "icon": "electron scripts/make-icon.cjs",
    "rename": "node scripts/rename.cjs"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/tiro-devanagari-sanskrit": "^5.3.0",
    "electron": "^45.1.0",
    "ink": "^8.0.0",
    "koffi": "^3.3.4",
    "react": "^19.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
